# Copy this file to .env and fill in your key.
# Get a free key at https://data.gov.in (sign up -> My Account -> API key)
DATA_GOV_API_KEY=
# OpenAQ: the same CPCB stations, without data.gov.in's block on non-Indian servers.
# Free key at https://explore.openaq.org (account settings -> API key)
OPENAQ_API_KEY=
# Which route brings CPCB station data: data.gov.in (only works from India) or openaq
STATION_FEED=data.gov.in

# --- Docker (docker compose) ---
# Database password: letters and digits only. Generate one with: openssl rand -hex 16
POSTGRES_PASSWORD=
# Port the website is published on: 8080 on your Mac, 80 on the server
WEB_PORT=8080
# Who can reach it: 127.0.0.1 = only this computer (your Mac), 0.0.0.0 = everyone (the server)
WEB_BIND=127.0.0.1
