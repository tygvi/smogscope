# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets — never commit API keys
.env

# Local database (regenerated by the pipeline)
data/*.db
data/*.db-shm
data/*.db-wal

# Generated docs (rebuild with ./docs/build.sh)
docs/build/

# Runtime logs
logs/

# Database backups (deploy/backup.sh writes outside the repo by default)
backups/

# Terraform: provider downloads, state (holds IDs and sometimes secrets), your values
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars

# Frontend
web/node_modules/
web/dist/
